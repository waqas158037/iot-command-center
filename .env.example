# IoT Command Center environment. Copy to .env and fill in. Never commit .env.
# Every value below is a placeholder; generate your own secrets.

# ── Database ──
# Local PostgreSQL (docker compose up -d db starts one with these credentials).
DATABASE_URL="postgresql://iot:iot@localhost:5432/iot_command_center?schema=public"
# Integration tests use a SEPARATE database whose name must contain "test"; the suite truncates it.
TEST_DATABASE_URL="postgresql://iot:iot@localhost:5432/iot_command_center_test?schema=public"

# ── Auth ──
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"
ENABLE_REGISTRATION="false"

# ── Seeding ──
# Demo users (admin/manager/engineer/viewer @demo.local) get this password. Leave empty to have the
# seed generate one and print it once. Demo data is skipped in production unless SEED_DEMO_DATA=true.
DEMO_PASSWORD=""
SEED_DEMO_DATA=""

# ── Simulator ──
ENABLE_SIMULATOR="true"
# Production builds refuse simulator controls unless this is explicitly true.
ALLOW_SIMULATOR_IN_PRODUCTION="false"

# ── Telemetry policy ──
DEVICE_HEARTBEAT_TIMEOUT_SECONDS="120"
TELEMETRY_MAX_LATE_SECONDS="604800"
TELEMETRY_MAX_FUTURE_SKEW_SECONDS="300"
INGEST_RATE_LIMIT_PER_MINUTE="120"

# ── MQTT ──
# Leave MQTT_BROKER_URL empty to run HTTP-only. The worker connects with the service account below;
# devices connect with username = device identifier and password = device secret.
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_BROKER_PORT="1883"
MQTT_USERNAME="icc-worker"
MQTT_PASSWORD="replace-with-a-random-mqtt-service-password"
MQTT_TOPIC_PREFIX="devices"
# Shared secret an external broker (EMQX) sends to /api/mqtt/auth and /api/mqtt/acl.
MQTT_HOOK_SECRET="replace-with-a-random-hook-secret"
# For TLS brokers (mqtts://): path to the CA certificate, and whether to verify it.
MQTT_CA_FILE=""
MQTT_REJECT_UNAUTHORIZED="true"

# ── Email (optional; without SMTP, notifications stay in-app and password reset is admin-driven) ──
SMTP_HOST=""
SMTP_PORT=""
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""

LOG_LEVEL="info"
